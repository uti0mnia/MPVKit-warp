+// Warp: the standard layout for a stream of more than two channels when the
+// output has none to read: 7.1 for seven or more (if the route takes eight),
+// else 5.1. Sets ao->channels to match, in the layout's own order; mpv's
+// remixer places the stream's speakers into it (side and back surrounds
+// stand in for each other). In 7.1 Ls/Rs are the side pair (SL/SR) and
+// Rls/Rrs the rear (BL/BR); 5.1's one surround pair takes either.
+static AudioChannelLayout warp_stream_layout(struct ao *ao, NSInteger maxChannels)
+{
+    static const uint8_t five_one[] = {
+        MP_SPEAKER_ID_FL, MP_SPEAKER_ID_FR, MP_SPEAKER_ID_FC, MP_SPEAKER_ID_LFE,
+        MP_SPEAKER_ID_SL, MP_SPEAKER_ID_SR,
+    };
+    static const uint8_t seven_one[] = {
+        MP_SPEAKER_ID_FL, MP_SPEAKER_ID_FR, MP_SPEAKER_ID_FC, MP_SPEAKER_ID_LFE,
+        MP_SPEAKER_ID_SL, MP_SPEAKER_ID_SR, MP_SPEAKER_ID_BL, MP_SPEAKER_ID_BR,
+    };
+    bool seven = ao->channels.num >= 7 && maxChannels >= 8;
+    const uint8_t *speakers = seven ? seven_one : five_one;
+    struct mp_chmap map = { .num = seven ? 8 : 6 };
+    for (int i = 0; i < map.num; i++)
+        map.speaker[i] = speakers[i];
+    ao->channels = map;
+    // MPEG_5_1_A: L R C LFE Ls Rs. MPEG_7_1_C: L R C LFE Ls Rs Rls Rrs.
+    return (AudioChannelLayout) {
+        .mChannelLayoutTag = seven ? kAudioChannelLayoutTag_MPEG_7_1_C
+                                   : kAudioChannelLayoutTag_MPEG_5_1_A,
+    };
+}
+
 static bool init_audiounit(struct ao *ao)
 {
     AudioStreamBasicDescription asbd;
@@ -148,22 +179,53 @@ static bool init_audiounit(struct ao *ao)
 
     err = au_get_ary(p->audio_unit, kAudioUnitProperty_AudioChannelLayout, kAudioUnitScope_Output,
                      0, (void**)&layout, &size);
-    CHECK_CA_ERROR_L(coreaudio_error_audiounit,
-                     "unable to retrieve audio unit channel layout");
