-        MP_ERR(ao, "unable to convert channel layout to list format\n");
-        goto coreaudio_error_audiounit;
+    // Warp: with tvOS 26.4's Continuous Audio Connection on, every HDMI
+    // route reports 32 unlabelled channels and the output scope has no
+    // layout to read (-10879): tvOS keeps its own output open and folds to
+    // whatever is plugged in. Play anyway: describe the stream's own 5.1 or
+    // 7.1 on the input scope, as VLC does, and let tvOS map it; stereo when
+    // the stream is stereo or tvOS refuses that.
+    bool input_layout = false;
+    AudioChannelLayout stream_layout = {0};
+    // Warp: WARP_AO_NO_LAYOUT=1 acts as if the layout were refused on a
+    // route offering 8 channels or more, to try this path on a simulator or
+    // a route that has one.
+    if (getenv("WARP_AO_NO_LAYOUT")) {
+        if (err == noErr)
+            talloc_free(layout);
+        layout = NULL;
+        err = kAudioUnitErr_InvalidProperty;
+        maxChannels = MAX(maxChannels, 8);
     }
+    if (err != noErr) {
+        // au_get_ary has already freed anything it allocated.
+        layout = NULL;
+        if (!af_fmt_is_spdif(ao->format) && ao->channels.num > 2 && maxChannels >= 6) {
+            input_layout = true;
+            stream_layout = warp_stream_layout(ao, maxChannels);
+            MP_WARN(ao, "no audio unit channel layout (%d), describing the stream's %d channels instead\n",
+                    (int)err, (int)ao->channels.num);
+        } else {
+            MP_WARN(ao, "no audio unit channel layout (%d), using stereo output\n", (int)err);
+        }
+    } else {
+        MP_VERBOSE(ao, "AU channel layout tag: %x (%x)\n", layout->mChannelLayoutTag, layout->mChannelBitmap);
 
-    for (UInt32 i = 0; i < layout->mNumberChannelDescriptions; i++) {
-        MP_VERBOSE(ao, "channel map: %i: %u\n", i, layout->mChannelDescriptions[i].mChannelLabel);
+        layout = convert_layout(layout, &size);
+        if (!layout) {
+            MP_ERR(ao, "unable to convert channel layout to list format\n");
+            goto coreaudio_error_audiounit;
+        }
+
+        for (UInt32 i = 0; i < layout->mNumberChannelDescriptions; i++) {
+            MP_VERBOSE(ao, "channel map: %i: %u\n", i, layout->mChannelDescriptions[i].mChannelLabel);
+        }
     }
 
-    if (af_fmt_is_spdif(ao->format) || instance.outputNumberOfChannels <= 2) {
+    if (input_layout) {
+        // The layout goes on before the unit is initialized, as VLC sets it.
+        AudioUnitUninitialize(p->audio_unit);
+    } else if (!layout || af_fmt_is_spdif(ao->format) || instance.outputNumberOfChannels <= 2) {
         ao->channels = (struct mp_chmap)MP_CHMAP_INIT_STEREO;
         MP_VERBOSE(ao, "using stereo output\n");
     } else {
@@ -197,6 +259,31 @@ static bool init_audiounit(struct ao *ao)
     CHECK_CA_ERROR_L(coreaudio_error_audiounit,
                      "unable to set render callback on audio unit");
 
+    if (input_layout) {
+        err = AudioUnitSetProperty(p->audio_unit, kAudioUnitProperty_AudioChannelLayout,
+                                   kAudioUnitScope_Input, 0, &stream_layout, sizeof(stream_layout));
+        if (err == noErr)
